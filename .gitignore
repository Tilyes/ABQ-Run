# ---------------------------------------------------------------
# 运行时状态：每台机器都不一样，里面存的是绝对路径
# ---------------------------------------------------------------
_state/
_test/_state_test/
_test/_state_shot/

# 打包产物
# 注意：不能写 *.zip，runtime/python312.zip 是 Python 标准库本体，必须提交
_pkg/
/ABQ-Run-*.zip

# Python 缓存
# 注意：不要写成 *.py[cod]，那个字符类会连 .pyd（C 扩展）一起忽略掉，
# 而 runtime/ 里的 .pyd 是运行时能启动的前提。
__pycache__/
*.pyc
*.pyo

# ---------------------------------------------------------------
# Abaqus 求解结果：体积大、可重新生成，不该进仓库
# ---------------------------------------------------------------
*.odb
*.dat
*.msg
*.sta
*.log
*.prt
*.sim
*.stt
*.res
*.lck
*.fil
*.pac
*.sel

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
